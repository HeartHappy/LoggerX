<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_log_black_t60_top_r8"
    android:orientation="vertical">

    <!-- 顶部 TabLayout 导航 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@color/color_base_translucent"
        app:tabMinWidth="0dp"
        app:tabTextAppearance="@style/MyTabTextStyle"
        app:tabIndicatorColor="@color/filter_text_selected"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="12dp"
        app:tabPaddingStart="12dp"
        app:tabSelectedTextColor="@color/filter_text_selected"
        app:tabTextColor="@color/filter_text_normal" />

    <!-- 内容容器：ViewPager2 + 加载进度 -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="400dp">

        <!-- ViewPager2 展示不同分类的过滤项 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 加载进度条 -->
        <ProgressBar
            android:id="@+id/pbDistinctLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- 重置按钮：使用描边样式，视觉较轻 -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/filter_reset"
            android:textColor="@color/filter_text_selected"
            android:textSize="14sp"
            android:background="@drawable/bg_log_button_stroke"
         />

        <!-- 确认按钮：使用实心样式，视觉较重，作为主要操作 -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:text="@string/filter_confirm"
            android:textColor="@color/color_base_white"
            android:textSize="14sp"
            android:background="@drawable/bg_log_button_selected" />
    </LinearLayout>

</LinearLayout>
